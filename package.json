{
  "name": "quiz-maker",
  "version": "2.0.0",
  "private": true,
  "description": "Create tests, share a link, see scores instantly. No sign-up. Installable on any device.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12 <25"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --watch backend/server.js",
    "dev:web": "vite",
    "build": "vite build",
    "vercel-build": "node backend/scripts/predeploy.js && vite build",
    "preview": "vite preview",
    "start": "node backend/server.js",
    "db:sync": "node backend/scripts/predeploy.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:pwa": "npm run build && playwright test -c playwright.pwa.config.js"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.6.0",
    "@mui/material": "^9.6.0",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "helmet": "^8.3.0",
    "papaparse": "^5.7.1",
    "pg": "^8.23.1",
    "pg-hstore": "^2.3.4",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.18.7",
    "read-excel-file": "^9.3.20",
    "sequelize": "^6.37.8",
    "write-excel-file": "^4.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "jsdom": "^29.1.1",
    "supertest": "^7.3.2",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.1",
    "workbox-build": "^7.4.1",
    "workbox-window": "^7.4.1"
  },
  "optionalDependencies": {
    "sqlite3": "^6.0.1"
  }
}
