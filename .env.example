# Copy this file to .env for local development. Never commit .env.
# On Vercel, set these in: Project → Settings → Environment Variables.

# ---------------------------------------------------------------------------
# Required in production
# ---------------------------------------------------------------------------

# Neon Postgres *pooled* connection string (Neon → Connect → "Connection pooling" on).
# Leave empty locally: `npm run dev` then uses a local SQLite file in .data/.
DATABASE_URL=

# Long random secret (at least 32 characters). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
APP_SECRET=

# Protects the daily cleanup job. Any long random string (generate it the same way).
CRON_SECRET=

# ---------------------------------------------------------------------------
# Optional: Cloudflare Turnstile bot check when publishing a test (free).
# Create a widget at https://dash.cloudflare.com → Turnstile, then set both keys.
# ---------------------------------------------------------------------------
TURNSTILE_SECRET_KEY=
VITE_TURNSTILE_SITE_KEY=

# ---------------------------------------------------------------------------
# Optional: limits (production defaults shown). Raise them when you upgrade plans.
# ---------------------------------------------------------------------------
# LIMIT_TESTS_PER_IP_HOUR=10
# LIMIT_TESTS_PER_IP_DAY=30
# LIMIT_TESTS_PER_DAY_GLOBAL=1000
# LIMIT_RESPONSES_PER_TEST=1000
# LIMIT_SUBMITS_PER_IP_PER_TEST_HOUR=300
# LIMIT_API_REQUESTS_PER_MIN=600
# Emergency switch: set to false to stop new tests being created (existing tests keep working).
# CREATION_ENABLED=true

# ---------------------------------------------------------------------------
# Only if the API runs on a different domain than the website (e.g. API on Render)
# ---------------------------------------------------------------------------
# CORS_ORIGINS=https://your-site.vercel.app
# VITE_API_URL=https://your-api.onrender.com
# Number of proxies in front of the API (Render: 1). Not used on Vercel.
# TRUST_PROXY=1
